{
  "name": "unreal-open-mcp-cli",
  "version": "0.0.1",
  "description": "Command-line setup and ops tooling for Unreal Open MCP (install-plugin, setup-mcp, open, status).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "unreal-open-mcp-cli": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node --test 'dist-test/**/*.test.js'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "unreal",
    "unreal-engine",
    "ai",
    "agent",
    "claude",
    "cursor",
    "cli"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "~5.6.2"
  },
  "license": "MIT",
  "author": "Unreal Open MCP",
  "homepage": "https://github.com/AlexeyPerov/Unreal-Open-MCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexeyPerov/Unreal-Open-MCP.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/AlexeyPerov/Unreal-Open-MCP/issues"
  }
}
